<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and below. API 31+ uses
   data_extraction_rules.xml, which excludes the same credential stores.

   Without explicit excludes this includes everything, which would ship
   sharedpref/encrypted_secrets.xml and file/datastore/settings.preferences_pb
   (legacy plaintext provider keys) to Google's cloud backup.
-->
<full-backup-content>
  <include domain="file" path="upload/" />
  <exclude domain="sharedpref" path="encrypted_secrets.xml" />
  <exclude domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
